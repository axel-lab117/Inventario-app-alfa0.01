# Database
DATABASE_URL="postgresql://wms:wms_secret@localhost:5432/wms?schema=public"
AUDIT_DATABASE_URL="postgresql://wms:wms_secret@localhost:5433/wms_audit?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# RabbitMQ
RABBITMQ_URL="amqp://wms:wms_secret@localhost:5672/wms"
RABBITMQ_USER=wms
RABBITMQ_PASSWORD=wms_secret
RABBITMQ_VHOST=wms

# Auth
JWT_SECRET="your-super-secret-jwt-key-change-in-production-min-32-chars"
JWT_REFRESH_SECRET="your-refresh-secret-change-in-production"

# App
NODE_ENV=development
PORT=4000
PUBLIC_API_URL="http://localhost:4000"
CORS_ORIGIN="http://localhost:3000,http://localhost:3001"

# MercadoLibre
ML_CLIENT_ID=your_ml_client_id
ML_CLIENT_SECRET=your_ml_client_secret

# Frávega
FRAVEGA_API_KEY=your_fravega_key

# Garbarino
GARBARINO_API_KEY=your_garbarino_key

# Megatone
MEGATONE_API_KEY=your_megatone_key

# MinIO (S3 compatible)
MINIO_ROOT_USER=wms
MINIO_ROOT_PASSWORD=wms_secret