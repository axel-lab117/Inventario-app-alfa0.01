{
  "name": "@repo/db",
  "version": "0.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf node_modules prisma/client"
  },
  "dependencies": {
    "@prisma/client": "^5.6.0",
    "neverthrow": "^6.0.0"
  },
  "devDependencies": {
    "prisma": "^5.6.0",
    "tsx": "^4.6.0",
    "typescript": "^5.3.0"
  }
}